# ---------------------------------------------------------------------------
# Portfolio assistant (app/api/chat)
# ---------------------------------------------------------------------------
# Server-only. No NEXT_PUBLIC_ prefix, so Next never inlines it into a client
# bundle. Leave it unset and the assistant answers from the local knowledge
# base in lib/assistant/knowledge.ts instead of failing.
LLM_API_KEY=

# "openai" (default) routes to any OpenAI-compatible /chat/completions API -
# OpenAI, Groq, OpenRouter, Together, a local llama.cpp server. "gemini" uses
# Google Generative Language.
LLM_PROVIDER=openai

# Optional overrides.
# LLM_MODEL=gpt-4o-mini          # gemini default: gemini-1.5-flash
# LLM_API_BASE=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Contact form (app/api/contact)
# ---------------------------------------------------------------------------
EMAIL_API_KEY=
CONTACT_EMAIL_TO=
EMAIL_FROM=
