# Public site origin for canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=

# Client collector. Set to false to disable analytics in the browser.
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Server-only Postgres connection. Never expose to the client.
# Leave empty locally to skip writes (API still validates).
DATABASE_URL=

# Contact form (Resend). Server-only. Never expose to the client.
CONTACT_EMAIL_TO=
EMAIL_API_KEY=
EMAIL_FROM=

