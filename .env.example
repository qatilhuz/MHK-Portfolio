# ---------------------------------------------------------------------------
# Portfolio assistant (app/api/chat)
# ---------------------------------------------------------------------------
# Server-only. No NEXT_PUBLIC_ prefix, so Next never inlines it into a client
# bundle. Leave it unset and the assistant answers from the local knowledge
# base in lib/assistant/knowledge.ts instead of failing.
#
# Groq key (starts with "gsk_"):  https://console.groq.com/keys
# Google AI Studio key ("AIza"):  https://aistudio.google.com/apikey
# OpenAI-compatible key starts with "sk-".
# Do not wrap the value in quotes and do not leave a trailing space - both are
# tolerated now, but they are the classic cause of "the model never answers".
LLM_API_KEY=

# "groq"    -> Groq (OpenAI-compatible, very fast)
# "gemini"  -> Google Generative Language (v1beta generateContent)
# "openai"  -> any other OpenAI-compatible /chat/completions API: OpenAI,
#              OpenRouter, Together, a local llama.cpp or Ollama server.
# If this is missing or misspelled it is inferred from the key format
# (gsk_ -> groq, AIza -> gemini, sk- -> openai).
LLM_PROVIDER=groq

# Optional. Defaults: groq -> llama-3.3-70b-versatile,
# gemini -> gemini-2.0-flash, openai -> gpt-4o-mini.
#
# Groq retires model ids on a rolling basis. If the one set here has been
# decommissioned the route reads GET /models, picks a live chat model and
# retries automatically, logging "Fallback to active Groq model: <id>" - so a
# stale value here degrades to one wasted call, not a broken assistant.
#
# Note the Gemini 1.5 series is not available to API keys created from
# mid-2025 onward; use a 2.x model.
# LLM_MODEL=llama-3.3-70b-versatile

# Optional. ONLY set this to point at a proxy or a self-hosted gateway.
# Leave it blank for Groq, Google and OpenAI alike - the correct base URL is
# chosen from LLM_PROVIDER. A value belonging to a different provider is
# ignored, and a groq.com base forces the Groq defaults.
# LLM_API_BASE=

# ---------------------------------------------------------------------------
# Contact form (app/api/contact)
# ---------------------------------------------------------------------------
EMAIL_API_KEY=
CONTACT_EMAIL_TO=
EMAIL_FROM=
